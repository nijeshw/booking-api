# Copy to .env and fill in the RDS values. Do not commit .env.
# The API does not start a database. Point these at AWS RDS for PostgreSQL.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# At least 32 characters. Used for session signing in the next phase.
AUTH_SECRET=replace-with-a-long-random-string

# Master database on RDS. Create it once, from the instance maintenance database:
#   CREATE DATABASE nexora_master;
MASTER_DATABASE_URL=postgresql://USER:PASSWORD@INSTANCE.REGION.rds.amazonaws.com:5432/nexora_master?sslmode=require

# Database used to apply the tenant schema during setup.
# Create it once: CREATE DATABASE nexora_tenant_dev;
# Each business later gets its own database on this same RDS instance.
TENANT_DATABASE_URL=postgresql://USER:PASSWORD@INSTANCE.REGION.rds.amazonaws.com:5432/nexora_tenant_dev?sslmode=require

# Stripe Checkout for plan upgrades. Leave unset until the Stripe account exists.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Each paid plan also needs its Stripe Price id stored on the plan row.
#
# Mail API. When all three are set, mail is sent.
# Otherwise messages are only written to the API log outside production.
# EMAIL_API_URL=https://mail.example.com/api/v1
# EMAIL_API_KEY=
# EMAIL_FROM=no-reply@example.com
